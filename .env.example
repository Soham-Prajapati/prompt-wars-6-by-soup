# Optional — the app works without either key, falling back to deterministic briefings.
GEMINI_API_KEY=
# First Gemini model to try (then the built-in Gemini fallback chain).
GEMINI_MODEL=
# Optional silent backup provider, tried only after Gemini's chain fails.
GROQ_API_KEY=
# First Groq model to try (then openai/gpt-oss-120b and qwen/qwen3.8-27b).
GROQ_MODEL=
